<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service for downloads -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- All files access for direct ROM writing to ES-DE structure -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Battery optimization exemption for reliable periodic sync -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- In-app self-update: download APK to cache + system installer -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Emuladores que el launcher detecta y lanza (core/launch/EmulatorCatalog.kt).
         Visibilidad de paquetes de Android 11+: solo se ven los declarados. -->
    <queries>
        <package android:name="com.retroarch" />
        <package android:name="com.retroarch.aarch64" />
        <package android:name="com.retroarch.ra32" />
        <package android:name="org.mupen64plusae.v3.fzurita" />
        <package android:name="org.mupen64plusae.v3.fzurita.pro" />
        <package android:name="com.armsx2" />
        <package android:name="come.nanodata.armsx2" />
        <package android:name="com.armsx3" />
        <package android:name="com.armsx3.play" />
        <package android:name="org.dolphinemu.dolphinemu" />
        <package android:name="org.dolphinemu.handheld" />
        <package android:name="dev.eden.eden_emulator" />
        <package android:name="xendroid.compose.fork" />
        <package android:name="xendroid.compose" />
        <package android:name="com.rfandango.haku_x" />
        <package android:name="me.magnum.melonds" />
        <package android:name="org.ppsspp.ppsspp" />
        <package android:name="org.ppsspp.ppssppgold" />
        <package android:name="org.azahar_emu.azahar" />
        <package android:name="info.cemu.cemu" />
    </queries>

    <application
        android:name=".RomMSyncApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.RomMSync"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.RomMSync">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Quick Settings tile: dispara un sync de saves sin abrir la app -->
        <service
            android:name=".data.sync.SyncTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_sync"
            android:label="Sync saves"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Subida de juegos en primer plano (sobrevive a cerrar la app) -->
        <service
            android:name=".upload.UploadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Vigilancia de saves en tiempo real (FileObserver + notificación fija) -->
        <service
            android:name=".data.sync.SaveSyncWatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".data.sync.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- WorkManager foreground service with dataSync type (Android 14+) -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Disable default WorkManager initializer — we use on-demand config -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Serves the downloaded update APK to the system installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
